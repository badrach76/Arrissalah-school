<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>فضاء الإدارة والصلاحيات - مؤسسة الرسالة للتعليم الخصوصي</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Cairo', sans-serif; }
        body { background-color: #f8fafc; color: #1e293b; display: flex; flex-direction: column; min-height: 100vh; }
        
        header { background: #ffffff; box-shadow: 0 2px 8px rgba(0,0,0,0.06); padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1000; }
        .brand-container { display: flex; flex-direction: column; text-decoration: none; }
        .logo { font-size: 18px; font-weight: 900; color: #0284c7; }
        .sub-logo { font-size: 10px; font-weight: 600; color: #64748b; text-transform: uppercase; }

        .menu-toggle { display: none; background: none; border: none; font-size: 24px; cursor: pointer; color: #0284c7; }
        .nav-menu { display: flex; list-style: none; gap: 20px; align-items: center; }
        .nav-menu a { text-decoration: none; color: #475569; font-weight: 600; font-size: 14px; cursor: pointer; }

        .layout-body { display: flex; flex: 1; }
        aside { width: 260px; background: #0f172a; color: white; padding: 20px; flex-shrink: 0; }
        .aside-menu { list-style: none; }
        .aside-menu li { margin-bottom: 8px; }
        .aside-menu a { color: #94a3b8; text-decoration: none; display: block; padding: 12px 15px; border-radius: 6px; font-size: 13.5px; font-weight: 600; cursor: pointer; transition: 0.3s; }
        .aside-menu a:hover, .aside-menu a.active { background: #0284c7; color: white; }

        .main-container { flex: 1; padding: 30px; overflow-y: auto; width: 100%; }
        
        .tab-content { display: none !important; background: white; padding: 25px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); margin-bottom: 25px; border-right: 4px solid #0284c7; }
        .tab-content.active { display: block !important; }
        
        .tab-content h2 { font-size: 17px; margin-bottom: 15px; color: #0f172a; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 10px; text-align: right; min-width: 600px; }
        th, td { padding: 10px 12px; border-bottom: 1px solid #e2e8f0; font-size: 13px; }
        th { background: #f1f5f9; color: #475569; font-weight: 700; }
        
        .btn { background: #0284c7; color: white; border: none; padding: 6px 14px; border-radius: 5px; cursor: pointer; font-size: 12px; font-weight: 600; text-decoration: none; display: inline-block; transition: 0.3s; }
        .btn:hover { background: #0369a1; }
        .btn-success { background: #10b981; }
        .whatsapp-btn { background: #25d366; margin-left: 4px; }
        
        .modal { display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; padding: 20px; }
        .modal-content { background: white; padding: 30px; border-radius: 10px; width: 100%; max-width: 500px; position: relative; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
        .close-modal { position: absolute; inset-inline-end: 20px; top: 15px; font-size: 22px; cursor: pointer; color: #64748b; }
        .form-control { width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; margin-bottom: 12px; outline: none; }

        @media (max-width: 768px) {
            .layout-body { flex-direction: column; }
            aside { width: 100%; height: auto; margin-bottom: 15px; }
            .main-container { padding: 15px; }
        }
    </style>
</head>
<body onload="initAdminPanel()">

    <header>
        <a href="index.html" class="brand-container">
            <div class="logo">مؤسسة الرسالة</div>
            <div class="sub-logo">للتعليم الخصوصي</div>
        </a>
        <button class="menu-toggle" onclick="toggleMenu()">☰</button>
        <ul class="nav-menu" id="navMenu">
            <li><span id="userRoleBadge" style="font-weight: bold; color: #0284c7; font-size: 13px; background: #e0f2fe; padding: 4px 10px; border-radius: 4px;">الإدارة</span></li>
            <li><a href="login.html" onclick="localStorage.removeItem('user_role');" style="color: #ef4444;">تسجيل خروج</a></li>
        </ul>
    </header>

    <div class="layout-body">
        <aside>
            <ul class="aside-menu" id="sideMenuContainer">
                <!-- القائمة الديناميكية حسب الصلاحية -->
            </ul>
        </aside>

        <div class="main-container">
            
            <!-- 1. لوحة القيادة الشاملة (تُحجب تماماً عن الحارس العام) -->
            <div id="tab-dash" class="tab-content active">
                <h2>لوحة المؤشرات الإحصائية والمالية الشاملة</h2>
                <div style="background: #f0fdf4; padding: 15px; border-radius: 8px; border-right: 4px solid #10b981; margin-bottom: 15px;">
                    <p id="welcomeMsg" style="font-weight: bold; color: #065f46;">مرحباً بك في فضاء الإدارة المركزي.</p>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                    <div style="background: #f1f5f9; padding: 20px; border-radius: 8px; border-right: 4px solid #10b981;">
                        <h3>إجمالي المداخيل</h3>
                        <p id="dashTotalIncome" style="font-size: 22px; font-weight: bold; margin-top: 5px; color: #10b981;">125,500 درهم</p>
                    </div>
                    <div style="background: #f1f5f9; padding: 20px; border-radius: 8px; border-right: 4px solid #ef4444;">
                        <h3>إجمالي المصاريف</h3>
                        <p id="dashTotalExpenses" style="font-size: 22px; font-weight: bold; margin-top: 5px; color: #ef4444;">45,000 درهم</p>
                    </div>
                </div>
            </div>

            <!-- 2. التلاميذ والأداءات (رقم المسار، الاسم الشخصي، العائلي، القسم، موسم الالتحاق) -->
            <div id="tab-students" class="tab-content">
                <h2>
                    <span>إدارة التلاميذ، الأداءات المالية وتحصيل الرسوم</span>
                    <button class="btn btn-success" onclick="openAddStudentModal()">+ إضافة تلميذ جديد</button>
                </h2>
                <table>
                    <thead>
                        <tr><th>رقم المسار</th><th>الاسم الشخصي</th><th>الاسم العائلي</th><th>القسم</th><th>موسم الالتحاق</th><th>الشهر المؤدى</th><th>العمليات</th></tr>
                    </thead>
                    <tbody id="studentsTableBody">
                        <tr>
                            <td>M138920</td>
                            <td>يوسف</td>
                            <td>البدري</td>
                            <td>السادس ابتدائي (أ)</td>
                            <td>2025/2026</td>
                            <td>
                                <select id="month_1" class="form-control" style="margin: 0; padding: 4px;">
                                    <option value="شتمبر 2026">شتمبر 2026</option>
                                    <option value="أكتوبر 2026">أكتوبر 2026</option>
                                </select>
                            </td>
                            <td>
                                <button class="btn btn-success" onclick="processStudentPayment('M138920', 'يوسف البدري', 'السادس ابتدائي (أ)', 500, 'month_1')">طباعة التوصيل والتحصيل</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- 3. الغياب والنقط (لائحة مباشرة ميسرة) -->
            <div id="tab-attendance-grades" class="tab-content">
                <h2><span>متابعة الغياب وإدخال النقط (لائحة التلاميذ المباشرة)</span></h2>
                <table>
                    <thead><tr><th>رقم المسار</th><th>الاسم الكامل</th><th>القسم</th><th>تسجيل الغياب</th><th>إدخال النقطة (على 20)</th><th>إجراء الاعتماد والنشر</th></tr></thead>
                    <tbody id="directGradesTable">
                        <tr>
                            <td>M138920</td>
                            <td>يوسف البدري</td>
                            <td>السادس ابتدائي (أ)</td>
                            <td>
                                <select id="att_status_1" class="form-control" style="margin:0; padding:4px;">
                                    <option value="حاضر">حاضر</option>
                                    <option value="غائب">غائب</option>
                                </select>
                            </td>
                            <td><input type="number" id="grade_val_1" class="form-control" placeholder="مثال: 17.5" style="margin:0; padding:4px;"></td>
                            <td><button class="btn btn-success" onclick="saveDirectGrade('يوسف البدري', 'grade_val_1', 'att_status_1')">حفظ وتحديث مباشر</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- 4. رواتب الأساتذة والواتساب -->
            <div id="tab-teachers" class="tab-content">
                <h2><span>رواتب الأساتذة الشهرية ومجموعات الواتساب</span></h2>
                <table>
                    <thead><tr><th>اسم الأستاذ</th><th>تاريخ الالتحاق</th><th>ساعات العمل</th><th>واتساب الفصول</th><th>الراتب</th><th>شهر الصرف</th><th>صرف الراتب</th></tr></thead>
                    <tbody>
                        <tr>
                            <td>أ. محمد العمراني</td>
                            <td>2022/09/01</td>
                            <td>24 ساعة</td>
                            <td><a href="https://whatsapp.com" target="_blank" class="btn whatsapp-btn">السادس أ</a></td>
                            <td>4500 درهم</td>
                            <td>
                                <select id="salary_m_1" class="form-control" style="margin:0; padding:4px;">
                                    <option value="شتمبر 2026">شتمبر 2026</option>
                                </select>
                            </td>
                            <td><button class="btn btn-success" onclick="payMonthlySalary('أ. محمد العمراني', 4500, 'salary_m_1')">صرف</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- 5. الموظفون الإداريون -->
            <div id="tab-staff" class="tab-content">
                <h2><span>الموظفون الإداريون ورواتبهم الشهرية</span></h2>
                <table>
                    <thead><tr><th>الاسم</th><th>الوظيفة</th><th>تاريخ الالتحاق</th><th>الراتب</th><th>شهر الصرف</th><th>صرف</th></tr></thead>
                    <tbody>
                        <tr>
                            <td>أحمد الداودي</td>
                            <td>حارس عام</td>
                            <td>2023/09/01</td>
                            <td>5000 درهم</td>
                            <td>
                                <select id="salary_m_staff" class="form-control" style="margin:0; padding:4px;">
                                    <option value="شتمبر 2026">شتمبر 2026</option>
                                </select>
                            </td>
                            <td><button class="btn btn-success" onclick="payMonthlySalary('أحمد الداودي', 5000, 'salary_m_staff')">صرف</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- 6. النقل المدرسي وطاقمه (البنزين، التأمين، الصيانة الخاصة بالطفل المدرسي) -->
            <div id="tab-transport" class="tab-content">
                <h2><span>النقل المدرسي وطاقمه ومصاريف التلميذ (بنزين، تأمين، صيانة)</span></h2>
                <div style="background: #f8fafc; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                    <h3 style="font-size: 14px; margin-bottom: 10px;">أجور طاقم النقل:</h3>
                    <table>
                        <thead><tr><th>الاسم</th><th>المهنة</th><th>الأجر الشهري</th><th>صرف</th></tr></thead>
                        <tbody>
                            <tr><td>سعيد بوطاهر</td><td>سائق الحافلة</td><td>4000 درهم</td><td><button class="btn btn-success" onclick="payMonthlySalary('سعيد بوطاهر (سائق)', 4000, 'salary_m_staff')">صرف</button></td></tr>
                        </tbody>
                    </table>
                </div>
                <h3 style="font-size: 14px; margin-bottom: 10px; color: #ef4444;">تسجيل مصاريف النقل (بنزين الحافلات، التأمين المدرسي للنقل، وصيانة الأسطول):</h3>
                <div style="display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap;">
                    <input type="text" id="transExpDesc" class="form-control" placeholder="نوع المصروف (مثال: تأمين النقل / صيانة / بنزين)" style="flex: 2; margin: 0;">
                    <input type="number" id="transExpAmount" class="form-control" placeholder="المبلغ (درهم)" style="flex: 1; margin: 0;">
                    <button class="btn btn-success" onclick="addTransportExpense()">تسجيل وصرف</button>
                </div>
            </div>

            <!-- 7. الخزينة العامة والمصاريف (مع جدول مصاريف أخرى) -->
            <div id="tab-finance" class="tab-content">
                <h2><span>الخزينة العامة ومصاريف المؤسسة وجدول مصاريف أخرى</span></h2>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">
                    <div style="background: #f8fafc; padding: 15px; border-radius: 8px;">إجمالي المداخيل: <strong id="finTotalIncome" style="color: #10b981;">125,500 درهم</strong></div>
                    <div style="background: #f8fafc; padding: 15px; border-radius: 8px;">إجمالي المصاريف: <strong id="finTotalExpenses" style="color: #ef4444;">45,000 درهم</strong></div>
                </div>

                <h3 style="font-size: 14px; margin-bottom: 10px; color: #ef4444;">جدول مصاريف أخرى:</h3>
                <div style="display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap;">
                    <input type="text" id="otherDesc" class="form-control" placeholder="بيان المصروف (أدوات، إصلاحات...)" style="flex: 2; margin: 0;">
                    <input type="number" id="otherAmount" class="form-control" placeholder="المبلغ (درهم)" style="flex: 1; margin: 0;">
                    <button class="btn btn-success" onclick="addOtherExpense()">إضافة للمصاريف</button>
                </div>

                <table>
                    <thead><tr><th>التاريخ</th><th>نوع العملية</th><th>المبلغ</th><th>البيان</th></tr></thead>
                    <tbody id="financialLogBody">
                        <tr><td>2026/09/01</td><td><span style="color: #ef4444; font-weight: bold;">خروج</span></td><td>2,500 درهم</td><td>كهرباء وماء</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- 8. صفحة الأنشطة التربوية -->
            <div id="tab-activities" class="tab-content">
                <h2><span>إدارة الأنشطة التربوية والموازية للمؤسسة</span></h2>
                <div style="background: #f8fafc; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                    <input type="text" id="actName" class="form-control" placeholder="عنوان النشاط التربوي (مثال: المسابقة الثقافية الكبرى)">
                    <input type="date" id="actDate" class="form-control">
                    <button class="btn btn-success" onclick="addActivity()">إدوة ونشر النشاط التربوي</button>
                </div>
                <table>
                    <thead><tr><th>عنوان النشاط</th><th>تاريخ التنظيم</th><th>الحالة</th></tr></thead>
                    <tbody id="activitiesTableBody">
                        <tr><td>حفل استقبال التلامذة الجدد</td><td>2026-09-07</td><td><span style="color:#10b981; font-weight:bold;">مبرمج</span></td></tr>
                    </tbody>
                </table>
            </div>

            <!-- 9. الرسائل والتواصل (خاصة للولي مباشرة أو عامة لمجموعة الواتساب) -->
            <div id="tab-comms" class="tab-content">
                <h2><span>إرسال الرسائل العامة والخاصة للأولياء عبر الواتساب</span></h2>
                <div style="background: #f8fafc; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <div class="form-group" style="margin-bottom: 15px;">
                        <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 5px;">نوع الرسالة:</label>
                        <select id="msgType" class="form-control" onchange="toggleMsgFields()">
                            <option value="private">رسالة خاصة لولي أمر (مباشرة على رقمه الخاص)</option>
                            <option value="public">رسالة عامة (عبر مجموعة واتساب الأولياء)</option>
                        </select>
                    </div>

                    <div id="privateFields" class="form-group" style="margin-bottom: 15px;">
                        <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 5px;">رقم واتساب ولي الأمر:</label>
                        <input type="text" id="parentPhone" class="form-control" placeholder="+212600000000">
                    </div>

                    <div id="publicFields" class="form-group" style="margin-bottom: 15px; display: none;">
                        <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 5px;">الوجهة العامة:</label>
                        <input type="text" class="form-control" value="مجموعة واتساب أولياء الأمور الرسمية" readonly style="background: #e2e8f0;">
                    </div>

                    <div class="form-group" style="margin-bottom: 15px;">
                        <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 5px;">محتوى الرسالة:</label>
                        <textarea id="msgContent" class="form-control" rows="4" placeholder="اكتب نص الرسالة..."></textarea>
                    </div>

                    <button class="btn" style="background: #25d366; font-size: 14px; padding: 10px 20px;" onclick="sendWhatsAppMessage()">إرسال عبر واتساب الآن</button>
                </div>
            </div>

        </div>
    </div>

    <!-- نافذة إضافة تلميذ بالمسار والاسم الشخصي والعائلي والقسم وموسم الالتحاق -->
    <div id="addStudentModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeAddStudentModal()">&times;</span>
            <h3 style="font-size: 16px; margin-bottom: 15px; color: #0284c7;">إضافة تلميذ جديد</h3>
            <form onsubmit="saveNewStudent(event)">
                <input type="text" id="newReg" class="form-control" placeholder="رقم المسار (مثال: M138920)" required>
                <input type="text" id="newFirstName" class="form-control" placeholder="الاسم الشخصي" required>
                <input type="text" id="newLastName" class="form-control" placeholder="الاسم العائلي" required>
                <input type="text" id="newClass" class="form-control" placeholder="القسم" required>
                <input type="text" id="newSeason" class="form-control" placeholder="موسم الالتحاق (مثال: 2026/2027)" required>
                <button type="submit" class="btn btn-success" style="width: 100%; padding: 10px;">حفظ التلميذ</button>
            </form>
        </div>
    </div>

    <script>
        let totalIncome = 125500;
        let totalExpenses = 45000;

            function initAdminPanel() {
        // جلب الدور، وإذا لم يوجد يتم توجيهه افتراضياً للمدير العام أ
